<%- include('partials/header') %>

<!-- 
  This is all the content that is UNIQUE to your Sign In page.
  The CSS for this is loaded from 'signin.css' via the header.
-->

<div class="signin-box">
  <h2>Sign In to LegalAid Pro</h2>
  <p>Access Your Legal dashboard</p>

  <form>
    <label>Email/ Username</label>
    <input type="text" placeholder="Enter your email or username">

    <label>Password</label>
    <input type="password" placeholder="Enter your password">

    <div class="options">
      <!-- This structure matches the .remember-me-label class in your CSS -->
      <label class="remember-me-label">
        <input type="checkbox"> Remember Me
      </label>
      <a href="#">Forgot Password?</a>
    </div>

    <button type="submit">Sign In</button>

    <!-- I've turned the "Create an Account" text into a link -->
    <p class="create">Don`t have an account? <a href="/signup">Create an Account</a></p>
  </form>
</div>

<%- include('partials/footer') %>