<%- include('partials/header') %>

<div class="signin-container">
    <div class="signin-box">
        <h2>Sign In to LegalAid Pro</h2>
        <p>Access Your Legal Dashboard</p>

        <form action="/login" method="POST">
            <label>Email / Username</label>
            <input type="text" name="email" placeholder="Enter your email or username" required>

            <label>Password</label>
            <input type="password" name="password" placeholder="Enter your password" required>

            <div class="options">
                <label class="remember-me-label">
                    <input type="checkbox"> Remember Me
                </label>
                <a href="#">Forgot Password?</a>
            </div>

            <button type="submit" class="signin-btn-submit">Sign In</button>

            <p class="create">Don't have an account? <a href="/signup">Create an Account</a></p>
        </form>
    </div>
</div>

<%- include('partials/footer') %>